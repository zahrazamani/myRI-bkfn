# Copy to frontend/.env

# Where the backend API lives. In production this is your own domain
# (the backend serves the frontend too, so same origin).
VITE_API_BASE_URL=http://localhost:8000

# Cloudflare Turnstile site key (public). Leave unset to disable the human check.
# Must be paired with MYRI_TURNSTILE_SECRET on the backend.
# VITE_TURNSTILE_SITE_KEY=

# Bot prompt version. "v2" (default, or unset) ships the reworked prompts:
# applied real-life examples on every bot, objection-first framing on The
# Journey, life-texture scenarios on Noor, story "make it theirs" beats on the
# Guardians' Club, the superhero side-quest pack, and the Better Me weekly loop.
# Set to "v1" to roll every bot back to the pre-rework prompts.
# VITE_PROMPT_VERSION=v1
