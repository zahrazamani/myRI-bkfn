# Copy to backend/.env and fill in. Only GEMINI_API_KEY is strictly required.

# Google AI Studio key. Text generation works on the free tier (with rate limits);
# image generation (generate_illustrations.py) needs billing enabled on the project.
GEMINI_API_KEY=

# ---- Generation ----
# gemini-3.1-flash-lite is the cheapest model this key can use ($0.25/$1.50 per 1M).
MYRI_CHAT_MODEL=gemini-3.1-flash-lite
# Prepend the Anthropic-style safety/grounding/tone layer (backend/claude_style.py).
# Set false when running on a model that already behaves this way.
# MYRI_STYLE_LAYER=true
# MYRI_CHAT_MAX_OUTPUT_TOKENS=1200
# MYRI_CHAT_TEMPERATURE=0.7

# ---- Retrieval ----
MYRI_EMBED_MODEL=models/gemini-embedding-001
# MYRI_RAG_FETCH_K=20
# MYRI_RAG_TOP_K=4
# MYRI_RERANK_ENABLED=true
# MYRI_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Bump after every re-ingest to invalidate the retrieval cache:
# MYRI_CORPUS_VERSION=2026-09-03

# ---- Abuse control ----
# MYRI_RATE_LIMIT_CHAT=8/minute;40/hour;150/day
# MYRI_DAILY_REQUEST_CAP=4000
# MYRI_DAILY_TOKEN_CAP=6000000
# MYRI_DAILY_REQUEST_CAP_PER_USER=120

# ---- "Bring it to life" kid illustrations (guardians-club) ----
# Runtime image generation (~$0.04/image, needs billing). Set false to turn the
# feature off entirely and guarantee no image spend.
# MYRI_KID_ART_ENABLED=true
# MYRI_KID_ART_MODEL=gemini-2.5-flash-image
# MYRI_KID_ART_MODERATION_MODEL=gemini-3.1-flash-lite   # must be a current model
# MYRI_KID_ART_MAX_DESC_CHARS=400
# MYRI_RATE_LIMIT_ILLUSTRATE=3/hour;6/day
# MYRI_KID_ART_DAILY_CAP=60           # whole-site cap per day
# MYRI_KID_ART_DAILY_CAP_PER_USER=3   # per login per day

# ---- Domain + CORS (production) ----
# MYRI_DOMAIN is used by the deploy stack (Caddy) to get an HTTPS cert.
# MYRI_DOMAIN=myri.example.org
# MYRI_ALLOWED_ORIGINS=https://myri.example.org

# ---- Cloudflare Turnstile (leave blank to disable human check) ----
# MYRI_TURNSTILE_SECRET=
# MYRI_SESSION_SIGNING_SECRET=long-random-string
# MYRI_SESSION_TTL_SECONDS=86400

# ---- Admin (needed to read/clear chat logs) ----
# MYRI_ADMIN_TOKEN=long-random-string
