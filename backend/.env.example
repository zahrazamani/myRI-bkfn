# Copy to backend/.env and fill in. Only GEMINI_API_KEY is strictly required.

# Google AI Studio key. Text generation works on the free tier (with rate limits);
# image generation (generate_illustrations.py) needs billing enabled on the project.
GEMINI_API_KEY=

# ---- Generation ----
# gemini-3.1-flash-lite is the cheapest model this key can use.
MYRI_CHAT_MODEL=gemini-3.1-flash-lite
# Published price of that model, USD per 1M tokens - used only for the /health
# cost estimate (not enforced). Update when you change the model.
# MYRI_PRICE_INPUT_PER_M_USD=0.10
# MYRI_PRICE_OUTPUT_PER_M_USD=0.40
# MYRI_PRICE_IMAGE_USD=0.04
# Prepend the Anthropic-style safety/grounding/tone layer (backend/claude_style.py).
# Set false when running on a model that already behaves this way.
# MYRI_STYLE_LAYER=true
# MYRI_CHAT_MAX_OUTPUT_TOKENS=1200
# MYRI_CHAT_TEMPERATURE=0.7

# ---- Retrieval ----
MYRI_EMBED_MODEL=models/gemini-embedding-001
# MYRI_RAG_FETCH_K=20
# MYRI_RAG_TOP_K=4
# MYRI_RERANK_ENABLED=true
# MYRI_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Bump after every re-ingest to invalidate the retrieval cache:
# MYRI_CORPUS_VERSION=2026-09-03

# ---- Abuse control ----
# MYRI_RATE_LIMIT_CHAT=8/minute;40/hour;150/day
# MYRI_DAILY_REQUEST_CAP=4000
# MYRI_DAILY_TOKEN_CAP=6000000
# MYRI_DAILY_REQUEST_CAP_PER_USER=120

# ---- "Bring it to life" kid illustrations (guardians-club) ----
# Runtime image generation (~$0.04/image, needs billing). OFF by default - turn on
# only after confirming the caps below behave. Worst-case spend/day = DAILY_CAP * $0.04.
# MYRI_KID_ART_ENABLED=false
# MYRI_KID_ART_MODEL=gemini-2.5-flash-image
# MYRI_KID_ART_MODERATION_MODEL=gemini-3.1-flash-lite   # must be a current model
# MYRI_KID_ART_MAX_DESC_CHARS=400
# MYRI_RATE_LIMIT_ILLUSTRATE=3/hour;6/day
# MYRI_KID_ART_DAILY_CAP=20           # whole-site cap per day  (20 * $0.04 = $0.80/day)
# MYRI_KID_ART_DAILY_CAP_PER_USER=2   # per login per day

# ---- Domain + CORS (production) ----
# MYRI_DOMAIN is used by the deploy stack (Caddy) to get an HTTPS cert - set it
# to your real domain when deploying (leave commented for local dev).
# MYRI_DOMAIN=myri.example.org
#
# !! REQUIRED IN PRODUCTION !!  Comma-separated list of your exact site
# origin(s). The default is "*" (fully open) and is DEV-ONLY. Once MYRI_DOMAIN
# is set (or MYRI_ENV=production), the app REFUSES TO START while this is still
# "*" - see backend/config.py. Edit the value below to your site, or set
# MYRI_ALLOW_WILDCARD_CORS=true to deliberately keep CORS open on a deployment.
MYRI_ALLOWED_ORIGINS=https://myri.example.org
# MYRI_ENV=production
# MYRI_ALLOW_WILDCARD_CORS=false

# ---- Google Sign-In (S4; leave blank to keep the plain email login) ----
# OAuth 2.0 Web client ID from Google Cloud Console. Must match
# VITE_GOOGLE_CLIENT_ID in frontend/.env. When set, per-user daily caps key off
# the verified Google account id instead of a self-typed email.
# MYRI_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Cloudflare Turnstile (leave blank to disable human check) ----
# MYRI_TURNSTILE_SECRET=
# MYRI_SESSION_SIGNING_SECRET=long-random-string
# MYRI_SESSION_TTL_SECONDS=86400

# ---- Admin (needed to read/clear chat logs) ----
# MYRI_ADMIN_TOKEN=long-random-string

# ---- Frontend build (VITE_*) ----
# These are baked into the JS bundle by `npm run build` INSIDE the Docker image
# (deploy/docker-compose.yml passes them as build args). Changing one needs a
# rebuild: `docker compose ... up -d --build`. For a local `npm run dev` build
# they instead come from frontend/.env.
#
# In production set VITE_API_BASE_URL to your site origin (the browser calls the
# API directly):
# VITE_API_BASE_URL=https://myri.example.org
#
# Google Sign-In (S4): the OAuth 2.0 *Web* client ID, SAME value as
# MYRI_GOOGLE_CLIENT_ID above. Leave unset to keep the plain email login.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#
# Cloudflare Turnstile public site key (pair with MYRI_TURNSTILE_SECRET):
# VITE_TURNSTILE_SITE_KEY=
#
# Bot prompt version: "v1" rolls every bot back to the pre-2026-09 prompts.
# VITE_PROMPT_VERSION=v1
