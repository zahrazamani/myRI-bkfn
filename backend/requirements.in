# Human-editable direct dependencies. The deploy/Dockerfile installs the fully
# pinned requirements.txt, not this file. After changing anything here:
#   pip install -r requirements.in && pip freeze | grep -v "^-e " > requirements.txt

fastapi
uvicorn[standard]
python-multipart
python-dotenv
pydantic

# LLM + RAG - no LangChain. google-genai does generation AND embeddings
# (backend/embeddings.py), the chromadb client is used directly (rag.py /
# ingest.py), and backend/textsplit.py replaces RecursiveCharacterTextSplitter.
google-genai
google-auth        # Google Sign-In ID-token verification (security.py)
chromadb
pymupdf           # ingest.py PDF extraction (cleaner than pypdf on these books)

# Abuse control
slowapi
httpx

# "Bring it to life" runtime illustration (kid_art.py) resizes the model output
Pillow

# Local reranker (multilingual cross-encoder). Pulls torch (~large). The app
# still runs without it - reranking just falls back to vector order.
sentence-transformers
